# Copy to .env (never commit .env). All values are optional for local use.
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SEED_CANDIDATES=20000
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=5
SHORTLIST_CACHE_TTL=600
ALLOWED_ORIGINS=
# Optional: enables the Claude rejection classifier. Without it the keyword classifier is used.
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-4-5
